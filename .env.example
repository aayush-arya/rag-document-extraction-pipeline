GOOGLE_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.8-flash        # change if this model id is not available to your key
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# OCR_BACKEND=auto                      # auto | tesseract | rapidocr | gemini | none
# OCR_CACHE_ENABLED=1                    # set 0 to disable local OCR result cache
# LLM_PROVIDER=gemini                    # gemini | openai-compatible | openrouter | groq | ollama
# LLM_MODEL=gemini-3.8-flash
# LLM_FALLBACK_PROVIDER=                 # e.g. openrouter, groq, ollama, or gemini
# LLM_FALLBACK_MODEL=
# LLM_FALLBACK_BASE_URL=                 # optional for OpenAI-compatible endpoints
# LLM_FALLBACK_API_KEY=                  # optional; provider-specific keys are also recognized
# PIPELINE_CACHE_ENABLED=1               # set 0 to disable local response caches
# PIPELINE_CACHE_DIR=data/cache
